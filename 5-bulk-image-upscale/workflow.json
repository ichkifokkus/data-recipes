            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5465b885-9ac8-50aa-9a4d-95d4b16fce0e",
              "leftValue": "={{ $json.image_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "f705800b-13ec-5ef0-abc3-c8c5ab227e1a",
              "leftValue": "={{ $json.upscaled_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6f88771-7727-5eb1-9b9d-343b80370c3f",
      "name": "Not done yet",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        400,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Groups the image URLs into batches. Each batch becomes one Apify run (keeps every run well under 5 minutes).\nconst BATCH_SIZE = 5;\nconst urls = [...new Set($input.all().map(i => String(i.json.image_url || '').trim()).filter(Boolean))];\nconst batches = [];\nfor (let i = 0; i < urls.length; i += BATCH_SIZE) batches.push({ json: { imageUrls: urls.slice(i, i + BATCH_SIZE) } });\nreturn batches;\n"
      },
      "id": "912c7449-5362-5c87-bc82-47a0fca85fd9",
      "name": "Batch URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/fast_data_asap~ai-image-upscaler/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ imageUrls: $json.imageUrls, scale: '4', outputFormat: 'jpg', quality: 92 }) }}",
        "options": {
          "timeout": 310000
        }
      },
      "id": "4c6e4fb4-a363-5493-91be-67a5fc95b01a",
      "name": "Upscale images",
